# Berkas terunggah (foto presensi, dokumen lamaran, dokumen aset) — data
# pribadi, disimpan lewat volume Docker `nuha_storage`, tidak pernah di-commit.
storage/

# Data sumber mentah (PII: data siswa/guru/SK) — jangan pernah di-commit
docs/*.xlsx
docs/*.pdf
docs/*.docx
docs/*.csv
docs/*.jpeg
docs/*.jpg
docs/*.png

# Artefak hasil jalan Playwright (screenshot, trace, laporan)
/test-results/
/playwright-report/

# Artefak deploy (scripts/deploy.sh) & log runtime — jangan sampai ikut
# ter-commit oleh `git add -A` (folder .next-prev berisi build lama ~200 MB+)
/.next-staging/
/.next-prev/
*.log

# Dump database mentah di root repo (PII santri) — arsipkan di luar repo,
# mis. /opt/nuha/sql-backups/ di server. Hanya root; migrasi Prisma di
# subfolder tidak terpengaruh pola ini.
/*.sql
/*.sql.gz
