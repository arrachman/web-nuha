// SIMTERPADU — Sistem Informasi Manajemen Terpadu
// Yayasan Pendidikan Islam Nurul Huda Mergosono
//
// Prinsip inti: SATU IDENTITAS, BANYAK PERAN.
// Seorang santri pondok yang juga siswa SMP adalah satu record `Person`
// dengan beberapa baris peran (Santri, Siswa, Pegawai, Wali), bukan
// beberapa record terpisah per unit.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Identitas & akses
// ─────────────────────────────────────────────────────────────

enum JenisKelamin {
  L
  P
}

enum RegionLevel {
  Province
  City
  District
  Village
}

enum RegionAliasType {
  FormerName
  AlternateSpelling
  Abbreviation
  LocalLanguage
}

model Country {
  id           Int      @id @default(autoincrement())
  iso2         String   @unique @db.Char(2)
  iso3         String   @unique @db.Char(3)
  numericCode  String?  @map("numeric_code") @db.Char(3)
  name         String   @db.VarChar(100)
  localName    String?  @map("local_name") @db.VarChar(100)
  phoneCode    String?  @map("phone_code") @db.VarChar(8)
  currencyCode String?  @map("currency_code") @db.Char(3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  regions          Region[]
  foreignAddresses ForeignAddress[]

  @@index([name])
  @@map("countries")
}

model Region {
  id           BigInt      @id @default(autoincrement())
  countryId    Int         @map("country_id")
  parentId     BigInt?     @map("parent_id")
  level        RegionLevel
  code         String      @db.VarChar(20)
  name         String      @db.VarChar(120)
  typeLabel    String?     @map("type_label") @db.VarChar(30)
  provinceId   BigInt?     @map("province_id")
  cityId       BigInt?     @map("city_id")
  districtId   BigInt?     @map("district_id")
  depth        Int         @default(1)
  fullName     String?     @map("full_name") @db.VarChar(400)
  postalCode   String?     @map("postal_code") @db.Char(5)
  latitude     Decimal?    @db.Decimal(10, 7)
  longitude    Decimal?    @db.Decimal(10, 7)
  areaKm2      Decimal?    @map("area_km2") @db.Decimal(12, 4)
  population   Int?
  isActive     Boolean     @default(true) @map("is_active")
  replacedById BigInt?     @map("replaced_by_id")
  createdAt    DateTime?   @default(now()) @map("created_at")
  updatedAt    DateTime?   @updatedAt @map("updated_at")

  country              Country         @relation(fields: [countryId], references: [id])
  parent               Region?         @relation("RegionParent", fields: [parentId], references: [id], onDelete: Cascade)
  children             Region[]        @relation("RegionParent")
  province             Region?         @relation("RegionProvince", fields: [provinceId], references: [id], onDelete: SetNull)
  provinceRegions      Region[]        @relation("RegionProvince")
  city                 Region?         @relation("RegionCity", fields: [cityId], references: [id], onDelete: SetNull)
  cityRegions          Region[]        @relation("RegionCity")
  district             Region?         @relation("RegionDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  districtRegions      Region[]        @relation("RegionDistrict")
  replacedBy           Region?         @relation("RegionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedRegions      Region[]        @relation("RegionReplacement")
  aliases              RegionAlias[]
  people               Person[]        @relation("PersonRegion")
  unitLocations        Unit[]          @relation("UnitRegion")
  institutionLocations InstitutionProfile[] @relation("InstitutionProfileRegion")
  applicants          Applicant[]          @relation("ApplicantRegion")

  @@unique([countryId, code])
  @@index([parentId, level, isActive])
  @@index([level, isActive])
  @@index([provinceId, cityId, districtId])
  @@index([postalCode])
  @@map("regions")
}

model RegionAlias {
  id       BigInt          @id @default(autoincrement())
  regionId BigInt          @map("region_id")
  alias    String          @db.VarChar(120)
  type     RegionAliasType

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, alias])
  @@index([alias])
  @@map("region_aliases")
}

model ForeignAddress {
  id           BigInt  @id @default(autoincrement())
  personId     BigInt  @unique @map("person_id")
  countryId    Int     @map("country_id")
  addressLine1 String  @map("address_line1") @db.VarChar(255)
  addressLine2 String? @map("address_line2") @db.VarChar(255)
  cityName     String? @map("city_name") @db.VarChar(120)
  stateName    String? @map("state_name") @db.VarChar(120)
  postalCode   String? @map("postal_code") @db.VarChar(20)
  isCurrent    Boolean @default(true) @map("is_current")

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  @@index([countryId])
  @@map("foreign_addresses")
}

model Person {
  id               BigInt       @id @default(autoincrement())
  nik              String?      @unique @db.VarChar(32)
  /// Nama tampilan sehari-hari (tanpa gelar). Tetap kolom utama yang dipakai
  /// seluruh UI & pencocokan jadwal guru — jangan ganti jadi nama lengkap.
  fullName         String       @db.VarChar(160)
  /// Gelar/sapaan kehormatan yang mendahului nama: "KH.", "Nyai Hj.", "Gus",
  /// "Ning", "Ustadz", "Ustadzah". Dipisah supaya bisa dirender/difilter
  /// tanpa mengurai string nama.
  gelar            String?      @db.VarChar(60)
  /// Nama panggilan akrab (mis. "Gus Alfan") untuk sapaan di UI/WA.
  panggilan        String?      @db.VarChar(80)
  /// Nama lengkap resmi termasuk gelar depan & belakang, sesuai dokumen.
  namaLengkap      String?      @map("nama_lengkap") @db.VarChar(255)
  gender           JenisKelamin
  birthDate        DateTime?    @map("birth_date") @db.Date
  birthPlace       String?      @map("birth_place") @db.VarChar(120)
  addressLine      String?      @db.VarChar(255)
  neighborhoodRt   String?      @db.VarChar(8)
  neighborhoodRw   String?      @db.VarChar(8)
  villageName      String?      @db.VarChar(120)
  districtName     String?      @db.VarChar(120)
  regencyName      String?      @db.VarChar(120)
  regionId         BigInt?      @map("region_id")
  postalCode       String?      @map("postal_code") @db.Char(5)
  familyCardNumber String?      @map("family_card_number") @db.VarChar(32)
  birthOrder       Int?         @map("birth_order")
  siblingCount     Int?         @map("sibling_count")
  hobby            String?      @db.VarChar(255)
  aspiration       String?      @map("aspiration") @db.VarChar(160)
  previousSchool   String?      @map("previous_school") @db.VarChar(160)
  highestEducation String?      @map("highest_education") @db.VarChar(80)
  phone            String?      @db.VarChar(32)
  email            String?      @unique @db.VarChar(160)
  photoUrl         String?      @map("photo_url") @db.VarChar(255)
  isActive         Boolean      @default(true)
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user              User?
  santri            Santri?
  riwayatPendidikan RiwayatPendidikan[]
  staff             Staff?
  waliDari          GuardianRelation[]        @relation("WaliOrang")
  sebagaiAnak       GuardianRelation[]        @relation("AnakOrang")
  region            Region?             @relation("PersonRegion", fields: [regionId], references: [id], onDelete: SetNull)
  foreignAddress    ForeignAddress?

  @@index([fullName])
  @@index([regionId])
  @@map("people")
}

model Role {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(32)
  name        String  @map("name") @db.VarChar(120)
  description String? @map("description") @db.VarChar(255)

  users     UserRole[]
  menuItems MenuRole[]

  @@map("roles")
}

model User {
  id           BigInt    @id @default(autoincrement())
  personId     BigInt    @unique @map("person_id")
  email        String    @unique @db.VarChar(160)
  username     String?   @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  unitScope    String?   @map("unit_scope") @db.VarChar(64)
  aktif        Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  person Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  roles  UserRole[]

  @@map("user")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId Int    @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model MenuItem {
  id    Int     @id @default(autoincrement())
  key   String  @unique @db.VarChar(32)
  label String  @db.VarChar(120)
  icon  String? @db.VarChar(255)
  order Int     @default(0) @map("order")

  roles MenuRole[]

  @@map("menu_items")
}

model MenuRole {
  menuId Int @map("menu_id")
  roleId Int @map("role_id")

  menu MenuItem @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([menuId, roleId])
  @@map("menu_roles")
}

model GuardianRelation {
  id         BigInt  @id @default(autoincrement())
  waliId     BigInt  @map("wali_id")
  anakId     BigInt  @map("anak_id")
  hubungan   String  @db.VarChar(48)
  pekerjaan  String? @db.VarChar(120)
  utama      Boolean @default(true)
  nik        String? @db.VarChar(32)
  ttl        String? @db.VarChar(120)
  pendidikan String? @db.VarChar(120)
  pendapatan String? @db.VarChar(64)
  /// "Ayah"/"Ibu"/"Wali" — sheet DATA WALI MURID memisahkan 3 blok NIK per peran.
  peran      String? @db.VarChar(16)

  wali Person @relation("WaliOrang", fields: [waliId], references: [id], onDelete: Cascade)
  anak Person @relation("AnakOrang", fields: [anakId], references: [id], onDelete: Cascade)

  @@unique([waliId, anakId])
  @@map("guardian_relations")
}

// ─────────────────────────────────────────────────────────────
// Unit, asrama, kelas
// ─────────────────────────────────────────────────────────────

/// Satu unit di bawah yayasan (SMP, MA, Pondok, Poskestren) beserta profil
/// kelembagaannya. Sebelum ini identitas unit (nama resmi, logo, kepala,
/// alamat) tersebar hardcoded di JSX; kolom-kolom profil di bawah menjadikan
/// tabel ini satu-satunya sumber kebenaran.
model Unit {
  id        Int     @id @default(autoincrement())
  key       String  @unique @db.VarChar(24)
  nama      String  @db.VarChar(160)
  deskripsi String? @db.VarChar(255)
  aktif     Boolean @default(true)

  /// Nama resmi lengkap untuk kop surat & halaman publik ("SMP Nurul Huda Mergosono").
  namaResmi       String?  @map("nama_resmi") @db.VarChar(200)
  /// Jenjang/klasifikasi: "SMP", "MA", "Pesantren", "Layanan Kesehatan".
  jenjang         String?  @db.VarChar(48)
  /// NPSN (sekolah) atau NSM/nomor statistik pesantren.
  npsn            String?  @db.VarChar(32)
  akreditasi      String?  @db.VarChar(8)
  tahunBerdiri    Int?     @map("tahun_berdiri")
  /// Path logo relatif terhadap `public/` (mis. `/assets/logo-nuha.webp`).
  logoPath        String?  @map("logo_path") @db.VarChar(255)
  alamat          String?  @db.VarChar(255)
  desaId          BigInt?  @map("desa_id")
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  telepon         String?  @db.VarChar(32)
  email           String?  @db.VarChar(160)
  website         String?  @db.VarChar(160)
  /// Nama kepala unit. Dipertahankan sebagai teks karena pegawai bisa belum
  /// terdaftar; `kepalaPegawaiId` adalah sumber kebenaran bila terisi.
  kepalaNama      String?  @map("kepala_nama") @db.VarChar(160)
  /// Sebutan jabatan kepala unit ("Kepala Sekolah", "Kepala Madrasah", "Pengasuh").
  kepalaJabatan   String?  @map("kepala_jabatan") @db.VarChar(120)
  headStaffId     BigInt?  @map("head_staff_id")
  visi            String?  @db.Text
  misi            String?  @db.Text

  kelas             Kelas[]
  santri            Santri[]
  santriKelas       SantriKelas[]
  riwayatPendidikan RiwayatPendidikan[]
  staff             Staff[]             @relation("PegawaiUnit")
  staffUnit         StaffUnit[]
  jadwal            JadwalPelajaran[]
  ujian             Ujian[]
  kepalaPegawai     Staff?              @relation("UnitKepala", fields: [headStaffId], references: [id])
  region            Region?             @relation("UnitRegion", fields: [desaId], references: [id], onDelete: SetNull)

  @@index([desaId])
  @@map("unit")
}

/// Profil yayasan induk — satu baris (`key = "yayasan"`), memuat identitas yang
/// dipakai lintas modul: kop slip gaji, footer publik, rekening resmi, pengasuh.
model InstitutionProfile {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(24)
  nama         String   @db.VarChar(200)
  namaArab     String?  @map("nama_arab") @db.VarChar(160)
  singkatan    String?  @db.VarChar(48)
  logoPath     String?  @map("logo_path") @db.VarChar(255)
  alamat       String?  @db.VarChar(255)
  desaId       BigInt?  @map("desa_id")
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  telepon      String?  @db.VarChar(32)
  email        String?  @db.VarChar(160)
  website      String?  @db.VarChar(160)
  tahunBerdiri Int?     @map("tahun_berdiri")
  /// Nomor akta/badan hukum yayasan.
  aktaNotaris  String?  @map("akta_notaris") @db.VarChar(160)
  ketuaNama    String?  @map("ketua_nama") @db.VarChar(160)
  pengasuhNama String?  @map("pengasuh_nama") @db.VarChar(160)
  /// Rekening resmi untuk pembayaran wali ("BSI 7011-2345-6789 a.n. ...").
  rekening     String?  @db.VarChar(160)
  visi         String?  @db.Text
  misi         String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  region    Region?  @relation("InstitutionProfileRegion", fields: [desaId], references: [id], onDelete: SetNull)

  @@index([desaId])
  @@map("institution_profiles")
}

model Kelas {
  id             Int     @id @default(autoincrement())
  unitId         Int     @map("unit_id")
  nama           String  @db.VarChar(32)
  tingkat        String  @db.VarChar(16)
  /// Deprecated: dipertahankan untuk kompatibilitas. Sumber kebenaran adalah `waliKelasId`.
  waliKelas      String? @map("wali_kelas") @db.VarChar(160)
  homeroomStaffId BigInt? @map("homeroom_staff_id")
  /// Kelas di-scope ke tahun ajaran karena satu unit bisa punya kelas "X" di
  /// beberapa tahun ajaran berbeda dengan isi santri yang berbeda pula.
  academicYearId Int?    @map("academic_year_id")

  unit             Unit          @relation(fields: [unitId], references: [id])
  waliKelasPegawai Staff?        @relation(fields: [homeroomStaffId], references: [id])
  academicYear     AcademicYear? @relation(fields: [academicYearId], references: [id])
  santri           Santri[]
  santriKelas      SantriKelas[]
  jadwalUjian      JadwalUjian[]
  sesiCbt          SesiCbt[]

  @@unique([unitId, nama, academicYearId])
  @@map("kelas")
}

model AcademicYear {
  id       Int     @id @default(autoincrement())
  code     String  @db.VarChar(16)
  semester String  @db.VarChar(8)
  isActive Boolean @default(false) @map("is_active")

  kelas             Kelas[]
  teachingLoads     TeachingLoad[]
  riwayatPendidikan RiwayatPendidikan[]

  @@unique([code, semester])
  @@map("academic_years")
}

model Dormitory {
  id         Int          @id @default(autoincrement())
  name       String       @unique @db.VarChar(120)
  gender     JenisKelamin
  capacity   Int          @default(0)
  supervisor String?      @map("supervisor") @db.VarChar(160)

  rooms Room[]

  @@map("dormitories")
}

model Room {
  id          Int    @id @default(autoincrement())
  dormitoryId Int    @map("dormitory_id")
  code        String @db.VarChar(16)
  capacity    Int    @default(0)

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
  santri    Santri[]

  @@unique([dormitoryId, code])
  @@map("rooms")
}

// ─────────────────────────────────────────────────────────────
// Santri & pegawai (peran dari Person)
// ─────────────────────────────────────────────────────────────

enum StatusSantri {
  Aktif
  TidakAktif
}

enum StatusRiwayatPendidikan {
  Aktif
  Lulus
  TidakAktif
}

model Santri {
  id         BigInt       @id @default(autoincrement())
  personId   BigInt       @unique @map("person_id")
  /// Sebagian data client hanya punya NISN, belum punya NIS. NIS dibuat
  /// deterministik oleh importir; NISN tetap sumber kebenaran identitas.
  nis        String?      @unique @db.VarChar(32)
  nisn       String?      @unique @db.VarChar(32)
  unitId     Int?         @map("unit_id")
  kelasId    Int?         @map("kelas_id")
  roomId     Int?         @map("room_id")
  status     StatusSantri @default(Aktif)
  program    String?      @db.VarChar(64)
  tahunMasuk String?      @map("tahun_masuk") @db.VarChar(8)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit   Unit?  @relation(fields: [unitId], references: [id])
  kelas  Kelas? @relation(fields: [kelasId], references: [id])
  room   Room?  @relation(fields: [roomId], references: [id])

  memorization   Memorization[]
  discipline     Discipline[]
  leavePermits   LeavePermit[]
  attendance     Attendance[]
  invoices       Invoice[]
  medicalRecords MedicalRecord[]
  nilai          Nilai[]
  kunjungan      Kunjungan[]
  nilaiUjian     NilaiUjian[]
  pesertaCbt     PesertaCbt[]
  healthProfile  HealthProfile?
  kelasLain      SantriKelas[]

  @@index([status])
  @@map("santri")
}

/// Penempatan rombel seorang santri, jamak: satu santri bisa sekolah formal di
/// SMP/MA **sekaligus** mengaji di Madin pada tahun ajaran yang sama. Kolom
/// `Santri.unitId/kelasId` dipertahankan sebagai penempatan UTAMA (dipakai
/// modul yang memang hanya butuh satu jawaban: kartu identitas, tagihan, kamar),
/// sedangkan tabel ini adalah sumber kebenaran untuk "santri ini ada di kelas
/// mana saja" — dipakai pohon induk, penyaring unit/kelas, dan presensi.
/// Baris dengan `utama = true` harus konsisten dengan kolom lama.
model SantriKelas {
  santriId  BigInt   @map("santri_id")
  kelasId   Int      @map("kelas_id")
  /// Disalin dari `Kelas.unitId` saat penulisan supaya penyaring per-unit tidak
  /// perlu join ke `kelas`; wajib sama dengan unit kelasnya.
  unitId    Int      @map("unit_id")
  utama     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)
  kelas  Kelas  @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([santriId, kelasId])
  @@index([kelasId])
  @@index([unitId])
  @@map("santri_kelas")
}

/// Jenjang yang pernah/sedang dijalani seorang `Person` (SD → SMP → MA, dst),
/// TERPISAH dari `Santri.status/unitId/kelasId` yang hanya menyimpan jenjang
/// AKTIF saat ini. Perlu supaya lulus SMP bisa dicatat tanpa menimpa status
/// aktif MA santri yang sama (satu Person hanya boleh punya satu baris Santri).
model RiwayatPendidikan {
  id             BigInt       @id @default(autoincrement())
  personId       BigInt       @map("person_id")
  unitId         Int          @map("unit_id")
  kelasNama      String       @map("kelas_nama") @db.VarChar(32)
  tingkat        String       @db.VarChar(16)
  academicYearId Int          @map("academic_year_id")
  status         StatusRiwayatPendidikan @default(Lulus)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([personId, unitId, academicYearId])
  @@map("riwayat_pendidikan")
}

/// Profil kesehatan sekali-isi (BB, TB, riwayat penyakit) — beda dari `MedicalRecord`
/// yang mencatat per-kunjungan poskestren.
model HealthProfile {
  /// PK sintetis supaya modul CRUD generik (yang selalu memakai kolom `id`)
  /// bisa mengelola tabel ini; `studentId` tetap unik — satu profil per santri.
  id             BigInt   @id @default(autoincrement())
  studentId      BigInt   @unique @map("student_id")
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 2)
  heightCm       Decimal? @map("height_cm") @db.Decimal(5, 2)
  bloodType      String?  @map("blood_type") @db.VarChar(3)
  medicalHistory String?  @map("medical_history") @db.VarChar(255)
  allergies      String?  @db.VarChar(255)
  specialNeeds   String?  @map("special_needs") @db.VarChar(255)
  notes          String?  @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")

  student Santri @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

model Staff {
  id               BigInt   @id @default(autoincrement())
  personId         BigInt   @unique @map("person_id")
  employeeNumber   String   @unique @map("employee_number") @db.VarChar(32)
  unitId           Int?     @map("unit_id")
  position         String   @db.VarChar(120)
  status           String   @db.VarChar(32)
  bankAccount      String?  @map("bank_account") @db.VarChar(64)
  lastEducation    String?  @map("last_education") @db.VarChar(120)
  subjectsTaught   String?  @map("subjects_taught") @db.VarChar(255)
  additionalDuties String?  @map("additional_duties") @db.VarChar(255)
  teachingHours    Int      @default(0) @map("teaching_hours")
  birthPlaceDate   String?  @map("birth_place_date") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  person              Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit                Unit?                @relation("PegawaiUnit", fields: [unitId], references: [id])
  unitDipimpin        Unit[]               @relation("UnitKepala")
  salaryComponent     SalaryComponent?
  paySlips            PaySlip[]
  kelasWali           Kelas[]
  jadwalAmpu          JadwalPelajaran[]
  jadwalPiket         JadwalPiket[]
  jurnalMengajar      JurnalMengajar[]
  attendances         StaffAttendance[]
  teachingLoads       TeachingLoad[]
  decreeArchives      DecreeArchive[]
  structuralPositions StructuralPosition[]
  otherUnits          StaffUnit[]

  @@map("staff")
}

/// Penugasan seorang pegawai di sebuah unit. Satu orang bisa mengabdi di lebih
/// dari satu lembaga (contoh: Alfan Jamil — guru Fikih di MA sekaligus asatidz
/// Madin), sehingga `Pegawai.unitId` saja tidak cukup.
///
/// `Pegawai.unitId` tetap ada dan berarti **unit utama** (dipakai untuk kolom
/// ringkas & urutan lama); tabel ini adalah daftar lengkap penugasannya dan
/// harus memuat unit utama itu juga, supaya filter/pohon kepegawaian cukup
/// membaca satu sumber.
model StaffUnit {
  staffId        BigInt   @map("staff_id")
  unitId         Int      @map("unit_id")
  position       String?  @map("position") @db.VarChar(120)
  employeeNumber String?  @map("employee_number") @db.VarChar(32)
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit  Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([staffId, unitId])
  @@index([unitId])
  @@map("staff_units")
}

/// Struktur organisasi dari SK pengangkatan (unit MA, pengurus asrama, dst).
/// SENGAJA BUKAN peran RBAC — jabatan struktural cuma metadata organisasi,
/// akses menu tetap diatur lewat `Peran`/`MenuPeran`. Satu orang boleh
/// menjabat lebih dari satu jabatan (contoh: Waka Sarpras + Kepala Lab),
/// jadi kunci unik berbasis (skNomor, urutan), bukan pegawaiId tunggal.
model StructuralPosition {
  id           BigInt   @id @default(autoincrement())
  decreeNumber String   @map("decree_number") @db.VarChar(64)
  order        Int      @default(0)
  position     String   @db.VarChar(160)
  scope        String   @db.VarChar(32)
  division     String?  @db.VarChar(120)
  startPeriod  DateTime @map("start_period") @db.Date
  endPeriod    DateTime @map("end_period") @db.Date
  staffId      BigInt?  @map("staff_id")
  sourceName   String   @map("source_name") @db.VarChar(160)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  staff Staff? @relation(fields: [staffId], references: [id])

  @@unique([decreeNumber, order])
  @@index([scope])
  @@map("structural_positions")
}

model SalaryComponent {
  staffId           BigInt  @id @map("staff_id")
  baseSalary        Decimal @default(0) @map("base_salary") @db.Decimal(14, 2)
  positionAllowance Decimal @default(0) @map("position_allowance") @db.Decimal(14, 2)
  familyAllowance   Decimal @default(0) @map("family_allowance") @db.Decimal(14, 2)
  teachingHours     Int     @default(0) @map("teaching_hours")
  hourlyRate        Decimal @default(0) @map("hourly_rate") @db.Decimal(14, 2)
  transport         Decimal @default(0) @db.Decimal(14, 2)
  bpjs              Decimal @default(0) @db.Decimal(14, 2)
  cooperative       Decimal @default(0) @db.Decimal(14, 2)
  incomeTax         Decimal @default(0) @map("income_tax") @db.Decimal(14, 2)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("salary_components")
}

model PaySlip {
  id            BigInt    @id @default(autoincrement())
  staffId       BigInt    @map("staff_id")
  period        String    @db.VarChar(16)
  grossAmount   Decimal   @map("gross_amount") @db.Decimal(14, 2)
  deduction     Decimal   @db.Decimal(14, 2)
  netAmount     Decimal   @map("net_amount") @db.Decimal(14, 2)
  paidAt        DateTime? @map("paid_at")
  // Revisi setelah pembayaran diizinkan; jejaknya disimpan di sini dan di audit_log.
  status        String    @default("Draft") @db.VarChar(16)
  revisionCount Int       @default(0) @map("revision_count")
  issuedBy      BigInt?   @map("issued_by")
  revisionNote  String?   @map("revision_note") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, period])
  @@map("pay_slips")
}

/// Jejak audit append-only: siapa melakukan apa, kapan, dan nilai apa yang berubah.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  aksi      String   @db.VarChar(48)
  entitas   String   @db.VarChar(48)
  entitasId String?  @map("entitas_id") @db.VarChar(64)
  ringkasan String   @db.VarChar(255)
  perubahan Json?
  aktorId   BigInt?  @map("aktor_id")
  aktorNama String   @default("anonim") @map("aktor_nama") @db.VarChar(160)
  ip        String?  @db.VarChar(64)
  waktu     DateTime @default(now())

  @@index([waktu])
  @@index([entitas, entitasId])
  @@map("audit_log")
}

