enum LeavePermitStatus {
  Pending
  Approved
  Rejected
  Completed
}

model LeavePermit {
  id         BigInt            @id @default(autoincrement())
  code       String            @unique @db.VarChar(24)
  studentId  BigInt            @map("student_id")
  type       String            @db.VarChar(64)
  reason     String            @db.VarChar(255)
  pickupBy   String?           @map("pickup_by") @db.VarChar(160)
  departedAt DateTime          @map("departed_at")
  returnedAt DateTime?         @map("returned_at")
  status     LeavePermitStatus @default(Pending)

  student Santri @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("leave_permits")
}

enum AttendanceStatus {
  Present
  Sick
  Excused
  Absent
  // New values are appended because this is a MySQL enum and existing order must remain stable.
  Late
  EarlyDeparture
}

model Attendance {
  id        BigInt           @id @default(autoincrement())
  studentId BigInt           @map("student_id")
  date      DateTime         @db.Date
  session   String           @db.VarChar(32)
  status    AttendanceStatus @default(Present)
  note      String?          @db.VarChar(255)

  student Santri @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, session])
  @@map("attendance_records")
}

model DailyActivity {
  id    Int     @id @default(autoincrement())
  time  String  @db.VarChar(16)
  name  String  @db.VarChar(160)
  note  String? @db.VarChar(255)
  order Int     @default(0)

  @@map("daily_activities")
}

