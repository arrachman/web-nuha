// ─────────────────────────────────────────────────────────────

model MataPelajaran {
  id        Int     @id @default(autoincrement())
  kode      String  @unique @db.VarChar(24)
  nama      String  @db.VarChar(160)
  jp        Int     @default(0)
  kelompok  String  @db.VarChar(64)
  guru      String? @db.VarChar(160)
  kkm       Int     @default(75)
  kurikulum String? @db.VarChar(64)

  nilai       Nilai[]
  capaian     CapaianPembelajaran[]
  jadwalUjian JadwalUjian[]
  soal        Soal[]
  paketSoal   PaketSoal[]

  @@map("mata_pelajaran")
}

model PerangkatAjar {
  id        Int    @id @default(autoincrement())
  kode      String @unique @db.VarChar(24)
  mapel     String @db.VarChar(160)
  kelas     String @db.VarChar(32)
  jenis     String @db.VarChar(64)
  topik     String @db.VarChar(200)
  pertemuan Int    @default(0)
  guru      String @db.VarChar(160)
  status    String @default("Draf") @db.VarChar(32)

  @@map("perangkat_ajar")
}

model CapaianPembelajaran {
  id      Int    @id @default(autoincrement())
  kode    String @unique @db.VarChar(24)
  mapelId Int?   @map("mapel_id")
  mapel   String @db.VarChar(160)
  fase    String @db.VarChar(32)
  capaian String @db.Text

  mataPelajaran MataPelajaran? @relation(fields: [mapelId], references: [id])

  @@map("capaian_pembelajaran")
}

model BankSoal {
  id      Int    @id @default(autoincrement())
  kode    String @unique @db.VarChar(24)
  mapel   String @db.VarChar(160)
  topik   String @db.VarChar(200)
  tipe    String @db.VarChar(64)
  level   String @db.VarChar(64)
  butir   Int    @default(0)
  dipakai Int    @default(0)
  penulis String @db.VarChar(160)

  @@map("bank_soal")
}

model Nilai {
  id       BigInt  @id @default(autoincrement())
  santriId BigInt  @map("santri_id")
  mapelId  Int     @map("mapel_id")
  periode  String  @db.VarChar(24)
  tugas    Decimal @default(0) @db.Decimal(5, 2)
  uts      Decimal @default(0) @db.Decimal(5, 2)
  uas      Decimal @default(0) @db.Decimal(5, 2)
  akhir    Decimal @default(0) @db.Decimal(5, 2)
  predikat String? @db.VarChar(8)

  santri Santri        @relation(fields: [santriId], references: [id], onDelete: Cascade)
  mapel  MataPelajaran @relation(fields: [mapelId], references: [id])

  @@unique([santriId, mapelId, periode])
  @@map("nilai")
}

model JadwalPelajaran {
  id        Int     @id @default(autoincrement())
  hari      String  @db.VarChar(16)
  jamKe     Int     @map("jam_ke")
  waktu     String  @db.VarChar(32)
  mapel     String  @db.VarChar(160)
  /// Deprecated: dipertahankan untuk kompatibilitas. Sumber kebenaran adalah `pegawaiId`.
  guru      String? @db.VarChar(160)
  staffId   BigInt? @map("staff_id")
  kelas     String? @db.VarChar(32)
  /// Tempat pelajaran berlangsung. Terpisah dari `kelas`: importir lama menyimpan
  /// ruangan ("Lab IPA", "Musholla") di kolom kelas, sehingga guru yang mengajar
  /// di luar ruang kelas kehilangan rombongan belajarnya.
  ruang     String? @db.VarChar(64)
  /// Unit tempat jam ini diajarkan. Seorang guru lazim mengampu di SMP dan MA
  /// sekaligus, bahkan merangkap ustadz di pondok — tanpa kolom ini, jadwalnya
  /// tercampur dan kartu "Kelas Saya" tak bisa dikelompokkan per unit.
  unitId    Int?    @map("unit_id")

  unit   Unit?            @relation(fields: [unitId], references: [id])
  staff  Staff?           @relation(fields: [staffId], references: [id])
  jurnal JurnalMengajar[]

  @@unique([hari, jamKe, kelas])
  @@index([guru])
  @@map("jadwal_pelajaran")
}

// ─────────────────────────────────────────────────────────────
// Fase 6 — piket, jurnal mengajar, presensi & beban pegawai, arsip SK
// ─────────────────────────────────────────────────────────────

/// Jadwal piket guru mingguan (bukan per-tanggal). Sumber saat ini: foto
/// jadwal piket MPLS yang dikonfirmasi client dipakai sebagai piket reguler
/// (lihat RENCANA-IMPORT.md §Fase 7.2). Prasyarat reminder `WA-GUR-04`.
model JadwalPiket {
  id           Int     @id @default(autoincrement())
  hari         String  @db.VarChar(16)
  waktuMulai   String  @map("waktu_mulai") @db.VarChar(16)
  waktuSelesai String  @map("waktu_selesai") @db.VarChar(16)
  staffId      BigInt? @map("staff_id")
  urutan       Int     @default(0)

  staff Staff? @relation(fields: [staffId], references: [id])

  // Satu shift = satu baris per (hari, jam mulai). Kunci ini yang membuat
  // importir piket idempoten; tanpa itu setiap jalan ulang menduplikasi.
  @@unique([hari, waktuMulai])
  @@index([hari])
  @@map("jadwal_piket")
}

/// Catatan mengajar per pertemuan (jurnal guru). Sumber: "PRESENSI DAN
/// JURNAL JULI-AGUSTUS AJARAN BARU 2025_111924.xlsx". `jadwalId` opsional
/// karena jurnal bisa dicatat untuk pertemuan yang tidak persis cocok ke
/// satu baris `JadwalPelajaran` (mis. jam pengganti).
model JurnalMengajar {
  id          BigInt   @id @default(autoincrement())
  staffId     BigInt?  @map("staff_id")
  jadwalId    Int?     @map("jadwal_id")
  kelas       String?  @db.VarChar(32)
  tgl         DateTime @db.Date
  jamKe       Int?     @map("jam_ke")
  materi      String?  @db.VarChar(255)
  catatan     String?  @db.VarChar(255)
  jumlahHadir Int?     @map("jumlah_hadir")
  createdAt   DateTime @default(now()) @map("created_at")

  staff  Staff?           @relation(fields: [staffId], references: [id])
  jadwal JadwalPelajaran? @relation(fields: [jadwalId], references: [id])

  @@index([tgl])
  @@index([staffId, tgl])
  @@map("jurnal_mengajar")
}

/// Staff attendance is separate from Student `Attendance`.
model StaffAttendance {
  id       BigInt           @id @default(autoincrement())
  staffId  BigInt           @map("staff_id")
  date     DateTime         @db.Date
  checkIn  String?          @map("check_in") @db.VarChar(16)
  checkOut String?          @map("check_out") @db.VarChar(16)
  status   AttendanceStatus @default(Present)
  notes    String?          @db.VarChar(255)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@map("staff_attendances")
}

/// Beban jam mengajar per pegawai per tahun ajaran. Strukturnya ada di SK
/// Pembagian Tugas Guru 2026, tapi ANGKANYA KOSONG di dokumen client —
/// model disiapkan lebih dulu, pengisian menunggu data dari client.
model TeachingLoad {
  id             BigInt  @id @default(autoincrement())
  staffId        BigInt  @map("staff_id")
  academicYearId Int?    @map("academic_year_id")
  subject        String? @db.VarChar(160)
  hours          Int?    @map("hours")
  notes          String? @db.VarChar(255)

  staff        Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([staffId])
  @@map("teaching_loads")
}

/// Arsip SK kepegawaian. Berkas asli TIDAK disajikan lewat `public/` —
/// mengikuti pola `docs-assets/` + route bergerbang (lihat
/// app/docs/tangkapan/[nama]/route.ts); `fileUrl` di sini menyimpan nama
/// berkas relatif ke direktori aman itu, bukan URL publik.
model DecreeArchive {
  id        BigInt   @id @default(autoincrement())
  number    String   @db.VarChar(64)
  title     String   @db.VarChar(200)
  date      DateTime @db.Date
  type      String   @db.VarChar(64)
  staffId   BigInt?  @map("staff_id")
  fileUrl   String?  @map("file_url") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([type])
  @@map("decree_archives")
}

/// Jadwal Madrasah Diniyah, terpisah dari `JadwalPelajaran` karena kuncinya
/// berbasis kitab & tempat non-kelas (Ndalem Abuya, Nuhamart Lt2, dst),
/// bukan @@unique([hari, jamKe, kelas]).
model JadwalDiniyah {
  id      Int    @id @default(autoincrement())
  hari    String @db.VarChar(16)
  jenjang String @db.VarChar(32)
  kitab   String @db.VarChar(160)
  ustadz  String @db.VarChar(160)
  tempat  String @db.VarChar(120)
  urutan  Int    @default(0)

  @@map("jadwal_diniyah")
}

/// Satu gelombang ujian (UTS/UAS/ujian pondok) pada satu unit dan periode.
model Ujian {
  id          Int      @id @default(autoincrement())
  kode        String   @unique @db.VarChar(24)
  nama        String   @db.VarChar(160)
  jenis       String   @db.VarChar(32)
  unitId      Int      @map("unit_id")
  tahunAjaran String   @map("tahun_ajaran") @db.VarChar(16)
  semester    String   @db.VarChar(16)
  mulai       DateTime @db.Date
  selesai     DateTime @db.Date
  status      String   @default("Draf") @db.VarChar(24)
  catatan     String?  @db.VarChar(255)

  unit   Unit          @relation(fields: [unitId], references: [id])
  jadwal JadwalUjian[]

  @@index([status])
  @@map("ujian")
}

/// Satu sesi ujian: satu mapel untuk satu kelas, dengan pengawasnya.
model JadwalUjian {
  id       Int      @id @default(autoincrement())
  ujianId  Int      @map("ujian_id")
  mapelId  Int      @map("mapel_id")
  kelasId  Int      @map("kelas_id")
  tgl      DateTime @db.Date
  waktu    String   @db.VarChar(32)
  durasi   Int      @default(90)
  ruang    String?  @db.VarChar(64)
  pengawas String?  @db.VarChar(160)

  ujian   Ujian         @relation(fields: [ujianId], references: [id], onDelete: Cascade)
  mapel   MataPelajaran @relation(fields: [mapelId], references: [id])
  kelas   Kelas         @relation(fields: [kelasId], references: [id])
  nilai   NilaiUjian[]
  sesiCbt SesiCbt[]

  @@unique([ujianId, mapelId, kelasId])
  @@map("jadwal_ujian")
}

/// Hasil satu santri pada satu sesi ujian. Terpisah dari `Nilai` yang menyimpan
/// rekap rapor per periode: di sini nilainya per sesi, lengkap dengan kehadiran.
model NilaiUjian {
  id       BigInt  @id @default(autoincrement())
  jadwalId Int     @map("jadwal_id")
  santriId BigInt  @map("santri_id")
  nilai    Decimal @default(0) @db.Decimal(5, 2)
  hadir    Boolean @default(true)
  catatan  String? @db.VarChar(255)

  jadwal JadwalUjian @relation(fields: [jadwalId], references: [id], onDelete: Cascade)
  santri Santri      @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@unique([jadwalId, santriId])
  @@map("nilai_ujian")
}

model KursusLms {
  id         Int    @id @default(autoincrement())
  kode       String @unique @db.VarChar(24)
  nama       String @db.VarChar(160)
  guru       String @db.VarChar(160)
  modul      Int    @default(0)
  selesai    Int    @default(0)
