  id                 BigInt          @id @default(autoincrement())
  registrationNumber String          @unique @map("registration_number") @db.VarChar(32)
  fullName           String          @map("full_name") @db.VarChar(160)
  gender             JenisKelamin?
  choice             String          @db.VarChar(64)
  previousSchool     String?         @map("previous_school") @db.VarChar(160)
  guardianPhone      String?         @map("guardian_phone") @db.VarChar(32)
  registeredAt       DateTime        @map("registered_at") @db.Date
  score              Decimal?        @db.Decimal(5, 2)
