model Kunjungan {
  id        BigInt   @id @default(autoincrement())
  santriId  BigInt   @map("santri_id")
  namaWali  String   @map("nama_wali") @db.VarChar(160)
  hubungan  String?  @db.VarChar(48)
  tgl       DateTime @db.Date
