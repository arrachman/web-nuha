model MedicalRecord {
  id             BigInt   @id @default(autoincrement())
  studentId      BigInt   @map("student_id")
  date           DateTime @db.Date
  time           String?  @db.VarChar(16)
  complaint      String   @db.VarChar(255)
  diagnosis      String?  @db.VarChar(255)
  treatment      String?  @db.VarChar(255)
  followUp       String?  @map("follow_up") @db.VarChar(120)
  /// Nilai baku tindak lanjut: Istirahat, Rawat, Rujuk, KembaliBelajar — tiga pertama otomatis jadi presensi Sakit.
  followUpStatus String?  @map("follow_up_status") @db.VarChar(16)
  officer        String   @db.VarChar(160)

  student Santri @relation(fields: [studentId], references: [id], onDelete: Cascade)

