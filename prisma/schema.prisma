model Invoice {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique @map("code") @db.VarChar(24)
  santriId   BigInt   @map("santri_id")
  type       String   @map("type") @db.VarChar(120)
  period     String   @map("period") @db.VarChar(24)
  amount     Decimal  @map("amount") @db.Decimal(14, 2)
  paidAmount Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  dueDate    DateTime @map("due_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  santri   Santri    @relation(fields: [santriId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([period])
  @@map("invoices")
}

model Payment {
  id        BigInt   @id @default(autoincrement())
  invoiceId BigInt   @map("invoice_id")
  date      DateTime @map("date") @db.Date
  amount    Decimal  @map("amount") @db.Decimal(14, 2)
  method    String   @map("method") @db.VarChar(64)
  reference String?  @map("reference") @db.VarChar(64)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum CashDirection {
  Inbound
  Outbound
}

model CashTransaction {
  id          BigInt        @id @default(autoincrement())
  code        String        @unique @map("code") @db.VarChar(24)
  date        DateTime      @map("date") @db.Date
  description String        @map("description") @db.VarChar(255)
  category    String        @map("category") @db.VarChar(64)
  method      String        @map("method") @db.VarChar(64)
  direction   CashDirection @map("direction")
  amount      Decimal       @map("amount") @db.Decimal(14, 2)

  @@index([date])
  @@map("cash_transactions")
}

