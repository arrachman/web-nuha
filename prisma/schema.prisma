enum ApplicantStatus {
  New
  Verification
  Selection
  Passed
  Failed
  Reenrollment
}

model Applicant {
  id                 BigInt          @id @default(autoincrement())
  registrationNumber String          @unique @map("registration_number") @db.VarChar(32)
  fullName           String          @map("full_name") @db.VarChar(160)
  gender             JenisKelamin?
  choice             String          @db.VarChar(64)
  previousSchool     String?         @map("previous_school") @db.VarChar(160)
  guardianPhone      String?         @map("guardian_phone") @db.VarChar(32)
  registeredAt       DateTime        @map("registered_at") @db.Date
  score              Decimal?        @db.Decimal(5, 2)
  status             ApplicantStatus @default(New)
  regionId           BigInt?         @map("region_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  documents ApplicantDocument[]
  region    Region?             @relation("ApplicantRegion", fields: [regionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([regionId])
  @@map("applicants")
}

model ApplicantDocument {
  id          BigInt  @id @default(autoincrement())
  applicantId BigInt  @map("applicant_id")
  name        String  @db.VarChar(120)
  fileUrl     String? @map("file_url") @db.VarChar(255)
  required    Boolean @default(true)
  verified    Boolean @default(false)

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@map("applicant_documents")
}

// ─────────────────────────────────────────────────────────────
// Rekrutmen — lowongan guru & staf, lamaran publik, seleksi, hire
// (plan/2026-09-modul-inti/03-rekrutmen-lowongan-kerja.md)
// ─────────────────────────────────────────────────────────────

enum JobType {
  Guru
  Staf
  Asatidz
  Musyrif
}

enum JobStatus {
  Draft
  PendingApproval
  Open
  Closed
  Cancelled
}

enum ApplicationStatus {
  Submitted
  Screening
  Shortlisted
  Test
  Interview
  Offered
  Hired
  Rejected
  Withdrawn
  Reserve
}

model JobPosting {
  id             BigInt        @id @default(autoincrement())
  code           String        @unique @db.VarChar(24)
  title          String        @db.VarChar(200)
  type           JobType
  unitId         Int           @map("unit_id")
  subject        String?       @db.VarChar(160)
  quota          Int           @default(1)
  employmentType String        @map("employment_type") @db.VarChar(32)
  genderReq      JenisKelamin? @map("gender_req")
  minEducation   String        @map("min_education") @db.VarChar(64)
  description    String        @db.Text
  requirements   String        @db.Text
  benefits       String?       @db.Text
  openAt         DateTime      @map("open_at")
  closeAt        DateTime      @map("close_at")
  status         JobStatus     @default(Draft)
  createdBy      BigInt        @map("created_by")
  approvedBy     BigInt?       @map("approved_by")
  approvedAt     DateTime?     @map("approved_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  unit         Unit                  @relation(fields: [unitId], references: [id])
  documents    JobRequiredDocument[]
  stages       JobStage[]
  applications JobApplication[]

  @@index([status])
  @@index([unitId])
  @@map("job_postings")
}

/// Berkas wajib per lowongan (03 §3), diisi otomatis dari templat saat lowongan dibuat, bisa ditambah/dikurangi panitia.
model JobRequiredDocument {
  id        BigInt  @id @default(autoincrement())
  jobId     BigInt  @map("job_id")
  code      String  @db.VarChar(32) // SURAT_LAMARAN, CV, IJAZAH, ...
  label     String  @db.VarChar(160)
  required  Boolean @default(true)
  maxSizeKb Int     @default(2048) @map("max_size_kb")
  accept    String  @default("pdf,jpg,png") @db.VarChar(64)

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, code])
  @@map("job_required_documents")
}

/// Tahap seleksi berurutan per lowongan (berkas, tes Qur'an/kitab, microteaching, wawancara, ...).
model JobStage {
  id     BigInt @id @default(autoincrement())
  jobId  BigInt @map("job_id")
  order  Int
  name   String @db.VarChar(160)
  weight Int    @default(0)

  job        JobPosting             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scores     ApplicationScore[]
  evaluators ApplicationEvaluator[]

  @@unique([jobId, order])
  @@map("job_stages")
}

model JobApplication {
  id                BigInt            @id @default(autoincrement())
  number            String            @unique @db.VarChar(24)
  jobId             BigInt            @map("job_id")
  status            ApplicationStatus @default(Submitted)
  nik               String            @db.VarChar(16)
  fullName          String            @map("full_name") @db.VarChar(160)
  gelar             String?           @db.VarChar(60)
  gender            JenisKelamin
  birthPlace        String            @map("birth_place") @db.VarChar(120)
  birthDate         DateTime          @map("birth_date") @db.Date
  phone             String            @db.VarChar(32)
  email             String?           @db.VarChar(160)
  addressLine       String            @map("address_line") @db.VarChar(255)
  regionId          BigInt?           @map("region_id")
  maritalStatus     String?           @map("marital_status") @db.VarChar(32)
  lastEducation     String            @map("last_education") @db.VarChar(80)
  major             String?           @db.VarChar(120)
  institution       String            @db.VarChar(160)
  graduationYear    Int               @map("graduation_year")
  gpa               Decimal?          @db.Decimal(3, 2)
  pesantrenHistory  String?           @map("pesantren_history") @db.Text
  quranMemorization Int?              @map("quran_memorization")
  kitabAbility      String?           @map("kitab_ability") @db.VarChar(120)
  experienceText    String?           @map("experience_text") @db.Text
  expectedSalary    Int?              @map("expected_salary")
  consentAt         DateTime          @map("consent_at")
  totalScore        Decimal?          @map("total_score") @db.Decimal(5, 2)
  personId          BigInt?           @map("person_id")
  statusToken       String            @unique @map("status_token") @db.VarChar(64)
  submittedIp       String?           @map("submitted_ip") @db.VarChar(64)
  createdAt         DateTime          @default(now()) @map("created_at")
  deletedAt         DateTime?         @map("deleted_at")

  job         JobPosting              @relation(fields: [jobId], references: [id])
  region      Region?                 @relation("ApplicationRegion", fields: [regionId], references: [id], onDelete: SetNull)
  person      Person?                 @relation(fields: [personId], references: [id])
  documents   ApplicationDocument[]
  educations  ApplicationEducation[]
  experiences ApplicationExperience[]
  scores      ApplicationScore[]
  events      ApplicationEvent[]
  evaluators  ApplicationEvaluator[]

  @@unique([jobId, nik])
  @@index([status])
  @@index([regionId])
  @@map("job_applications")
}

model ApplicationDocument {
  id            BigInt  @id @default(autoincrement())
  applicationId BigInt  @map("application_id")
  code          String  @db.VarChar(32)
  fileId        BigInt  @map("file_id")
  verified      Boolean @default(false)
  verifiedBy    BigInt? @map("verified_by")
  note          String? @db.VarChar(255)

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  file        FileObject     @relation(fields: [fileId], references: [id])

  @@index([applicationId])
  @@map("application_documents")
}

model ApplicationEducation {
  id             BigInt  @id @default(autoincrement())
  applicationId  BigInt  @map("application_id")
  level          String  @db.VarChar(40)
  institution    String  @db.VarChar(160)
  major          String? @db.VarChar(120)
  graduationYear Int?    @map("graduation_year")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_educations")
}

model ApplicationExperience {
  id            BigInt @id @default(autoincrement())
  applicationId BigInt @map("application_id")
  institution   String @db.VarChar(160)
  position      String @db.VarChar(120)
  fromYear      Int?   @map("from_year")
  toYear        Int?   @map("to_year")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_experiences")
}

model ApplicationScore {
  id            BigInt  @id @default(autoincrement())
  applicationId BigInt  @map("application_id")
  stageId       BigInt  @map("stage_id")
  evaluatorId   BigInt  @map("evaluator_id")
  score         Decimal @db.Decimal(5, 2)
  note          String? @db.Text

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage       JobStage       @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([applicationId, stageId, evaluatorId])
  @@map("application_scores")
}

/// Riwayat status untuk pelamar & panitia (halaman cek status menampilkan ini).
model ApplicationEvent {
  id            BigInt             @id @default(autoincrement())
  applicationId BigInt             @map("application_id")
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  note          String?            @db.VarChar(255)
  scheduleAt    DateTime?          @map("schedule_at")
  location      String?            @db.VarChar(160)
  actorId       BigInt?            @map("actor_id")
  createdAt     DateTime           @default(now()) @map("created_at")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_events")
}

/// Penilai tamu per lamaran (guru senior mapel, pengasuh untuk tes Qur'an/kitab) — izin sesaat, bukan peran permanen (05 §5.1).
model ApplicationEvaluator {
  applicationId BigInt @map("application_id")
  userId        BigInt @map("user_id")
  stageId       BigInt @map("stage_id")

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage       JobStage       @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@id([applicationId, userId, stageId])
  @@map("application_evaluators")
}

// ─────────────────────────────────────────────────────────────
// Kunjungan wali
// ─────────────────────────────────────────────────────────────

model Kunjungan {
  id        BigInt   @id @default(autoincrement())
  santriId  BigInt   @map("santri_id")
  namaWali  String   @map("nama_wali") @db.VarChar(160)
  hubungan  String?  @db.VarChar(48)
  tgl       DateTime @db.Date
  jamMasuk  String?  @map("jam_masuk") @db.VarChar(16)
  jamKeluar String?  @map("jam_keluar") @db.VarChar(16)
  keperluan String?  @db.VarChar(255)
  status    String   @default("Terjadwal") @db.VarChar(32)

  santri Santri @relation(fields: [santriId], references: [id], onDelete: Cascade)

  @@index([tgl])
  @@map("kunjungan")
}

// ─────────────────────────────────────────────────────────────
// Notifikasi WhatsApp
// ─────────────────────────────────────────────────────────────

model WaTemplate {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(24)
  role     String  @db.VarChar(64)
  title    String  @db.VarChar(160)
  trigger  String  @db.VarChar(255)
  schedule String? @db.VarChar(120)
  content  String  @db.Text
  isActive Boolean @default(true) @map("is_active")

  logs WaLog[]

  @@map("wa_templates")
}

model WaLog {
  id         BigInt   @id @default(autoincrement())
  templateId Int?     @map("template_id")
  recipient  String   @db.VarChar(160)
  phone      String   @db.VarChar(32)
  content    String   @db.Text
  status     String   @default("Terkirim") @db.VarChar(24)
  messageId  String?  @map("message_id") @db.VarChar(96)
  error      String?  @db.VarChar(255)
  sentAt     DateTime @default(now()) @map("sent_at")

  template WaTemplate? @relation(fields: [templateId], references: [id])

  @@index([sentAt])
  @@map("wa_logs")
}

// ─────────────────────────────────────────────────────────────
// Fase 7 — penjadwal notifikasi WA (cron eksternal, bukan setInterval Next.js)
// ─────────────────────────────────────────────────────────────

/// Satu baris = satu "job" penjadwal yang dijalankan proses `nuha-cron`.
/// `kodeTemplate` di sini adalah kode JOB, bukan selalu identik dengan
/// `TemplateWa.kode` — WA-GUR-04 punya dua pemicu waktu (H-1 pukul 19.00 dan
/// H-0 45 menit sebelum shift, keduanya dinamis per baris `JadwalPiket`)
/// sehingga dipecah jadi dua job (`WA-GUR-04-H1`, `WA-GUR-04-H0`) yang
/// keduanya mengirim template `WA-GUR-04` yang sama. Lihat `lib/penjadwal/`.
model NotificationSchedule {
  id           Int       @id @default(autoincrement())
  templateCode String    @unique @map("template_code") @db.VarChar(32)
  cron         String    @db.VarChar(32)
  isActive     Boolean   @default(true) @map("is_active")
  lastRunAt    DateTime? @map("last_run_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("notification_schedules")
}

/// Idempotent queue. `recipientId` identifies the recipient within a job.
model NotificationQueue {
  id            BigInt   @id @default(autoincrement())
  templateCode  String   @map("template_code") @db.VarChar(32)
  recipientId   String   @map("recipient_id") @db.VarChar(64)
  scheduledDate DateTime @map("scheduled_date") @db.Date
  status        String   @default("Terkirim") @db.VarChar(24)
  waLogId       BigInt?  @map("wa_log_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([templateCode, recipientId, scheduledDate])
  @@index([scheduledDate])
  @@map("notification_queue")
}

// ─────────────────────────────────────────────────────────────
// Pengumuman & agenda
// ─────────────────────────────────────────────────────────────

model Announcement {
  id        BigInt   @id @default(autoincrement())
  date      DateTime @db.Date
  title     String   @db.VarChar(200)
  content   String   @db.Text
  target    String   @default("Semua") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("announcements")
}

model Agenda {
  id    BigInt   @id @default(autoincrement())
  date  DateTime @db.Date
  time  String?  @db.VarChar(16)
  title String   @db.VarChar(200)
  unit  String?  @db.VarChar(64)

  @@index([date])
  @@map("agenda")
}

model Testimoni {
  id      BigInt @id @default(autoincrement())
  nama    String @db.VarChar(120)
  inisial String @db.VarChar(4)
  ket     String @db.VarChar(160)
  kata    String @db.VarChar(500)

  @@map("testimoni")
}

// ---------------------------------------------------------------------------
// CBT — ujian berbasis komputer
//
// `BankSoal` yang lama hanya menyimpan metadata paket (jumlah butir, penulis)
// untuk layar kurikulum. Butir soal sungguhan hidup di `Soal` + `OpsiSoal`,
// dirakit jadi `PaketSoal`, lalu dijadwalkan lewat `SesiCbt`. Nilai akhir tetap
// mengalir ke `NilaiUjian` supaya rapor dan analisis lama tidak perlu diubah.
// ---------------------------------------------------------------------------

/// Satu butir soal. `tipe` menentukan cara koreksi: PG/PGK/BS/Menjodohkan
/// dikoreksi otomatis, Esai/Uraian menunggu penilaian guru.
model Soal {
  id         BigInt   @id @default(autoincrement())
  mapelId    Int      @map("mapel_id")
  penulis    String   @db.VarChar(160)
  tipe       TipeSoal @default(PG)
  level      String   @default("C1") @db.VarChar(8)
  topik      String?  @db.VarChar(200)
  /// Konteks/stimulus bersama (wacana AKM). Kosong untuk soal berdiri sendiri.
  stimulus   String?  @db.Text
  pertanyaan String   @db.Text
  /// Jawaban benar untuk tipe isian singkat; PG memakai OpsiSoal.benar.
  kunci      String?  @db.VarChar(255)
  pembahasan String?  @db.Text
  bobot      Decimal  @default(1) @db.Decimal(6, 2)
  /// Parameter IRT hasil kalibrasi: a=daya beda, b=tingkat kesulitan, c=tebakan.
  irtA       Decimal? @map("irt_a") @db.Decimal(6, 3)
  irtB       Decimal? @map("irt_b") @db.Decimal(6, 3)
  irtC       Decimal? @map("irt_c") @db.Decimal(6, 3)
  /// Statistik klasik, diperbarui tiap kali analisis butir dijalankan.
  pDiff      Decimal? @map("p_diff") @db.Decimal(6, 3)
  dIndex     Decimal? @map("d_index") @db.Decimal(6, 3)
  dipakai    Int      @default(0)
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  mapel MataPelajaran    @relation(fields: [mapelId], references: [id])
  opsi  OpsiSoal[]
  butir ButirPaket[]
  jawab JawabanPeserta[]

  @@index([mapelId, tipe])
  @@index([aktif])
  @@map("soal")
}

enum TipeSoal {
  PG
  PGK
  BS
  Menjodohkan
  IsianSingkat
  Esai
}

model OpsiSoal {
  id     BigInt  @id @default(autoincrement())
  soalId BigInt  @map("soal_id")
  label  String  @db.VarChar(4)
  teks   String  @db.Text
  benar  Boolean @default(false)
  urutan Int     @default(0)

  soal Soal @relation(fields: [soalId], references: [id], onDelete: Cascade)

  @@unique([soalId, label])
  @@map("opsi_soal")
}

/// Rakitan soal yang siap diujikan. Satu paket dipakai berulang di banyak sesi.
model PaketSoal {
  id          Int      @id @default(autoincrement())
  kode        String   @unique @db.VarChar(24)
  nama        String   @db.VarChar(160)
  mapelId     Int      @map("mapel_id")
  /// Jenis penilaian: Harian, UTS, UAS, AKM, TryOut.
  jenis       String   @default("UTS") @db.VarChar(32)
  durasi      Int      @default(90)
  /// Acak urutan soal & opsi per peserta agar tetangga tidak sama layarnya.
  acakSoal    Boolean  @default(true) @map("acak_soal")
  acakOpsi    Boolean  @default(true) @map("acak_opsi")
  /// Tampilkan skor & pembahasan segera setelah peserta submit.
  tampilHasil Boolean  @default(false) @map("tampil_hasil")
  kkm         Int      @default(75)
  status      String   @default("Draf") @db.VarChar(24)
  penulis     String   @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at")

  mapel MataPelajaran @relation(fields: [mapelId], references: [id])
  butir ButirPaket[]
  sesi  SesiCbt[]

  @@index([status])
  @@map("paket_soal")
}

model ButirPaket {
  id      BigInt  @id @default(autoincrement())
  paketId Int     @map("paket_id")
  soalId  BigInt  @map("soal_id")
  urutan  Int     @default(0)
  bobot   Decimal @default(1) @db.Decimal(6, 2)

  paket PaketSoal @relation(fields: [paketId], references: [id], onDelete: Cascade)
  soal  Soal      @relation(fields: [soalId], references: [id], onDelete: Cascade)

  @@unique([paketId, soalId])
  @@map("butir_paket")
}

/// Penyelenggaraan satu paket untuk satu kelas pada waktu tertentu.
/// Boleh berdiri sendiri (ulangan harian) atau menempel ke sesi `JadwalUjian`.
model SesiCbt {
  id               Int      @id @default(autoincrement())
  kode             String   @unique @db.VarChar(24)
  paketId          Int      @map("paket_id")
  kelasId          Int      @map("kelas_id")
  jadwalId         Int?     @map("jadwal_id")
  mulai            DateTime @map("mulai")
  selesai          DateTime @map("selesai")
  /// Token yang diketik peserta sebelum masuk; diputar tiap sesi.
  token            String   @db.VarChar(12)
  /// Kunci lokasi: hanya IP dengan awalan ini yang boleh mengerjakan
  /// (zone-locked exam di jaringan lab sekolah). Kosong = tanpa kunci.
  ipPrefix         String?  @map("ip_prefix") @db.VarChar(64)
  /// Wajib memakai Exam Browser; permintaan dari browser biasa ditolak.
  wajibExamBrowser Boolean  @default(false) @map("wajib_exam_browser")
  /// Berapa kali peserta boleh keluar layar sebelum sesinya dibekukan.
  batasPelanggaran Int      @default(3) @map("batas_pelanggaran")
  status           String   @default("Terjadwal") @db.VarChar(24)
  pengawas         String?  @db.VarChar(160)
  createdAt        DateTime @default(now()) @map("created_at")

  paket   PaketSoal    @relation(fields: [paketId], references: [id])
  kelas   Kelas        @relation(fields: [kelasId], references: [id])
  jadwal  JadwalUjian? @relation(fields: [jadwalId], references: [id])
  peserta PesertaCbt[]

  @@index([status])
  @@map("sesi_cbt")
}

/// Satu peserta pada satu sesi: kartu ujian, urutan soal acaknya, dan hasilnya.
model PesertaCbt {
  id          BigInt        @id @default(autoincrement())
  sesiId      Int           @map("sesi_id")
  santriId    BigInt        @map("santri_id")
  /// Nomor peserta yang tercetak di kartu ujian.
  noPeserta   String        @map("no_peserta") @db.VarChar(32)
  status      StatusPeserta @default(Belum)
  mulaiAt     DateTime?     @map("mulai_at")
  selesaiAt   DateTime?     @map("selesai_at")
  /// Urutan soal hasil pengacakan, disimpan agar refresh tidak mengubah soal.
  urutan      String?       @db.Text
  skor        Decimal       @default(0) @db.Decimal(6, 2)
  benar       Int           @default(0)
  salah       Int           @default(0)
  kosong      Int           @default(0)
  /// Estimasi kemampuan hasil skoring IRT (theta).
  theta       Decimal?      @db.Decimal(6, 3)
  pelanggaran Int           @default(0)
  ipTerakhir  String?       @map("ip_terakhir") @db.VarChar(64)
  createdAt   DateTime      @default(now()) @map("created_at")

  sesi    SesiCbt          @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  santri  Santri           @relation(fields: [santriId], references: [id], onDelete: Cascade)
  jawaban JawabanPeserta[]
  log     LogKecurangan[]

  @@unique([sesiId, santriId])
  @@index([status])
  @@map("peserta_cbt")
}

enum StatusPeserta {
  Belum
  Mengerjakan
  Selesai
  Dibekukan
}

model JawabanPeserta {
  id          BigInt   @id @default(autoincrement())
  pesertaId   BigInt   @map("peserta_id")
  soalId      BigInt   @map("soal_id")
  /// Label opsi terpilih (PG) atau teks jawaban (isian/esai).
  jawaban     String?  @db.Text
  ragu        Boolean  @default(false)
  benar       Boolean?
  skor        Decimal  @default(0) @db.Decimal(6, 2)
  /// Diisi guru untuk esai; null berarti belum dinilai.
  dinilaiOleh String?  @map("dinilai_oleh") @db.VarChar(160)
  updatedAt   DateTime @updatedAt @map("updated_at")

  peserta PesertaCbt @relation(fields: [pesertaId], references: [id], onDelete: Cascade)
  soal    Soal       @relation(fields: [soalId], references: [id], onDelete: Cascade)

  @@unique([pesertaId, soalId])
  @@map("jawaban_peserta")
}

/// Jejak setiap dugaan kecurangan. Tidak pernah dihapus otomatis: pengawas
/// yang memutuskan apakah sesi peserta dibuka kembali.
model LogKecurangan {
  id        BigInt   @id @default(autoincrement())
  pesertaId BigInt   @map("peserta_id")
  jenis     String   @db.VarChar(48)
  detail    String?  @db.VarChar(255)
  at        DateTime @default(now())

  peserta PesertaCbt @relation(fields: [pesertaId], references: [id], onDelete: Cascade)

  @@index([pesertaId])
  @@map("log_kecurangan")
}

// ============================================================================
// Pengaturan umum key-value (04-aset-sarpras §5: ambang nominal persetujuan
// disimpan di pengaturan, bukan konstanta; dipakai juga presensi).
// ============================================================================
model AppSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ============================================================================
// Modul Sarpras (plan 04-aset-sarpras.md)
// ============================================================================
enum LocationType {
  Kampus
  Gedung
  Lantai
  Ruang
  Area
}

enum AssetCondition {
  Baik
  RusakRingan
  RusakBerat
  Hilang
}

enum AssetStatus {
  Aktif
  Dipinjam
  DalamPerbaikan
  TidakDipakai
  MenungguPenghapusan
  Dihapus
}

/// Pohon lokasi (kampus → gedung → lantai → ruang/area). Bukan pengganti Room asrama; ditautkan opsional.
model AssetLocation {
  id         Int             @id @default(autoincrement())
  code       String          @unique @db.VarChar(32)
  name       String          @db.VarChar(160)
  type       LocationType
  parentId   Int?            @map("parent_id")
  unitId     Int?            @map("unit_id")
  roomUsage  String?         @map("room_usage") @db.VarChar(32)
  areaM2     Decimal?        @map("area_m2") @db.Decimal(8, 2)
  capacity   Int?
  condition  AssetCondition?
  kelasId    Int?            @map("kelas_id")
  roomId     Int?            @map("room_id")
  picStaffId BigInt?         @map("pic_staff_id")
  qrToken    String          @unique @map("qr_token") @db.VarChar(32)
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at")

  parent    AssetLocation?  @relation("LokasiInduk", fields: [parentId], references: [id])
  children  AssetLocation[] @relation("LokasiInduk")
  unit      Unit?           @relation("LokasiUnit", fields: [unitId], references: [id])
  assets    Asset[]
  damages   DamageReport[]
  loanItems AssetLoanItem[]

  @@index([parentId])
  @@index([unitId])
  @@map("asset_locations")
}

model AssetCategory {
  id               Int     @id @default(autoincrement())
  code             String  @unique @db.VarChar(24)
  name             String  @db.VarChar(120)
  kibGroup         String  @map("kib_group") @db.VarChar(1)
  parentId         Int?    @map("parent_id")
  usefulLifeYears  Int?    @map("useful_life_years")
  isConsumable     Boolean @default(false) @map("is_consumable")
  needsMaintenance Boolean @default(false) @map("needs_maintenance")

  assets Asset[]

  @@map("asset_categories")
}

model FundingSource {
  id                 Int     @id @default(autoincrement())
  code               String  @unique @db.VarChar(24)
  name               String  @db.VarChar(120)
  restrictedDisposal Boolean @default(false) @map("restricted_disposal")

  assets       Asset[]
  procurements Procurement[]

  @@map("funding_sources")
}

model Vendor {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(160)
  phone   String? @db.VarChar(32)
  address String? @db.VarChar(255)
  npwp    String? @db.VarChar(32)
  note    String? @db.VarChar(255)

  assets  Asset[]
  damages DamageReport[]

  @@map("vendors")
}

model Asset {
  id                BigInt         @id @default(autoincrement())
  inventoryCode     String         @unique @map("inventory_code") @db.VarChar(48)
  qrToken           String         @unique @map("qr_token") @db.VarChar(32)
  name              String         @db.VarChar(200)
  categoryId        Int            @map("category_id")
  ownerUnitId       Int            @map("owner_unit_id")
  locationId        Int?           @map("location_id")
  holderStaffId     BigInt?        @map("holder_staff_id")
  brand             String?        @db.VarChar(80)
  model             String?        @db.VarChar(80)
  specification     String?        @db.Text
  serialNumber      String?        @map("serial_number") @db.VarChar(80)
  quantity          Int            @default(1)
  unitOfMeasure     String         @default("unit") @map("unit_of_measure") @db.VarChar(24)
  acquisitionDate   DateTime       @map("acquisition_date") @db.Date
  acquisitionMethod String         @map("acquisition_method") @db.VarChar(32)
  acquisitionCost   Decimal        @map("acquisition_cost") @db.Decimal(15, 2)
  isEstimatedValue  Boolean        @default(false) @map("is_estimated_value")
  fundingSourceId   Int            @map("funding_source_id")
  donorName         String?        @map("donor_name") @db.VarChar(160)
  vendorId          Int?           @map("vendor_id")
  procurementId     BigInt?        @map("procurement_id")
  cashTransactionId BigInt?        @map("cash_transaction_id")
  usefulLifeYears   Int?           @map("useful_life_years")
  residualValue     Decimal?       @map("residual_value") @db.Decimal(15, 2)
  warrantyUntil     DateTime?      @map("warranty_until") @db.Date
  condition         AssetCondition @default(Baik)
  status            AssetStatus    @default(Aktif)
  isBorrowable      Boolean        @default(false) @map("is_borrowable")
  attributes        Json?
  note              String?        @db.Text
  createdBy         BigInt         @map("created_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  category      AssetCategory       @relation(fields: [categoryId], references: [id])
  ownerUnit     Unit                @relation("AsetPemilik", fields: [ownerUnitId], references: [id])
  location      AssetLocation?      @relation(fields: [locationId], references: [id])
  holder        Staff?              @relation("AsetPemegang", fields: [holderStaffId], references: [id])
  fundingSource FundingSource       @relation(fields: [fundingSourceId], references: [id])
  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  procurement   Procurement?        @relation(fields: [procurementId], references: [id])
  files         AssetFile[]
  movements     AssetMovement[]
  loanItems     AssetLoanItem[]
  damages       DamageReport[]
  maintenance   MaintenanceTask[]
  opnameLines   StockOpnameLine[]
  disposalItems AssetDisposalItem[]

  @@index([ownerUnitId])
  @@index([locationId])
  @@index([categoryId])
  @@index([status])
  @@map("assets")
}

/// Foto & dokumen aset (kuitansi, faktur, BAST, sertifikat, AIW, BPKB, STNK, garansi).
model AssetFile {
  id        BigInt   @id @default(autoincrement())
  assetId   BigInt   @map("asset_id")
  fileId    BigInt   @map("file_id")
  kind      String   @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  file  FileObject @relation("BerkasAset", fields: [fileId], references: [id])

  @@index([assetId])
  @@map("asset_files")
}

model Procurement {
  id              BigInt    @id @default(autoincrement())
  code            String    @unique @db.VarChar(24)
  unitId          Int       @map("unit_id")
  title           String    @db.VarChar(200)
  reason          String    @db.Text
  status          String    @db.VarChar(32)
  estimatedTotal  Decimal   @map("estimated_total") @db.Decimal(15, 2)
  fundingSourceId Int       @map("funding_source_id")
  requestedBy     BigInt    @map("requested_by")
  receivedAt      DateTime? @map("received_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  unit          Unit              @relation("PengadaanUnit", fields: [unitId], references: [id])
  fundingSource FundingSource     @relation(fields: [fundingSourceId], references: [id])
  requester     User              @relation("PengadaanPengusul", fields: [requestedBy], references: [id])
  items         ProcurementItem[]
  assets        Asset[]

  @@index([status])
  @@map("procurements")
}

model ProcurementItem {
  id             BigInt   @id @default(autoincrement())
  procurementId  BigInt   @map("procurement_id")
  name           String   @db.VarChar(200)
  categoryId     Int      @map("category_id")
  quantity       Int
  estimatedPrice Decimal  @map("estimated_price") @db.Decimal(15, 2)
  actualPrice    Decimal? @map("actual_price") @db.Decimal(15, 2)

  procurement Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)

  @@map("procurement_items")
}

model AssetMovement {
  id             BigInt   @id @default(autoincrement())
  assetId        BigInt   @map("asset_id")
  type           String   @db.VarChar(32)
  fromLocationId Int?     @map("from_location_id")
  toLocationId   Int?     @map("to_location_id")
  fromUnitId     Int?     @map("from_unit_id")
  toUnitId       Int?     @map("to_unit_id")
  fromHolderId   BigInt?  @map("from_holder_id")
  toHolderId     BigInt?  @map("to_holder_id")
  date           DateTime
  reason         String?  @db.VarChar(255)
  bastFileId     BigInt?  @map("bast_file_id")
  actorId        BigInt   @map("actor_id")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_movements")
}

model AssetLoan {
  id              BigInt          @id @default(autoincrement())
  code            String          @unique @db.VarChar(24)
  borrowerUserId  BigInt          @map("borrower_user_id")
  borrowerUnitId  Int?            @map("borrower_unit_id")
  purpose         String          @db.VarChar(255)
  startAt         DateTime        @map("start_at")
  endAt           DateTime        @map("end_at")
  status          String          @db.VarChar(24)
  approvedBy      BigInt?         @map("approved_by")
  returnedAt      DateTime?       @map("returned_at")
  returnCondition AssetCondition? @map("return_condition")
  returnNote      String?         @map("return_note") @db.VarChar(255)
  createdAt       DateTime        @default(now()) @map("created_at")

  borrower User            @relation("PeminjamAset", fields: [borrowerUserId], references: [id])
  items    AssetLoanItem[]

  @@index([status])
  @@map("asset_loans")
}

/// Satu baris = satu aset ATAU satu ruang (pemesanan ruang).
model AssetLoanItem {
  id         BigInt  @id @default(autoincrement())
  loanId     BigInt  @map("loan_id")
  assetId    BigInt? @map("asset_id")
  locationId Int?    @map("location_id")

  loan     AssetLoan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  asset    Asset?         @relation(fields: [assetId], references: [id])
  location AssetLocation? @relation(fields: [locationId], references: [id])

  @@index([assetId])
  @@index([locationId])
  @@map("asset_loan_items")
}

model DamageReport {
  id                BigInt    @id @default(autoincrement())
  code              String    @unique @db.VarChar(24)
  assetId           BigInt?   @map("asset_id")
  locationId        Int?      @map("location_id")
  reporterUserId    BigInt    @map("reporter_user_id")
  description       String    @db.Text
  severity          String    @db.VarChar(16)
  photoFileId       BigInt?   @map("photo_file_id")
  status            String    @db.VarChar(24)
  assignedTo        BigInt?   @map("assigned_to")
  vendorId          Int?      @map("vendor_id")
  cost              Decimal?  @db.Decimal(15, 2)
  resolvedAt        DateTime? @map("resolved_at")
  resolutionNote    String?   @map("resolution_note") @db.VarChar(255)
  cashTransactionId BigInt?   @map("cash_transaction_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  asset    Asset?         @relation(fields: [assetId], references: [id])
  location AssetLocation? @relation(fields: [locationId], references: [id])
  reporter User           @relation("PelaporKerusakan", fields: [reporterUserId], references: [id])
  assignee User?          @relation("TeknisiKerusakan", fields: [assignedTo], references: [id])
  vendor   Vendor?        @relation(fields: [vendorId], references: [id])

  @@index([status])
  @@index([assetId])
  @@map("damage_reports")
}

model MaintenanceTask {
  id               BigInt    @id @default(autoincrement())
  assetId          BigInt?   @map("asset_id")
  locationId       Int?      @map("location_id")
  title            String    @db.VarChar(160)
  intervalDays     Int?      @map("interval_days")
  dueDate          DateTime  @map("due_date") @db.Date
  remindDaysBefore Int       @default(7) @map("remind_days_before")
  assignedTo       BigInt?   @map("assigned_to")
  status           String    @db.VarChar(16)
  lastDoneAt       DateTime? @map("last_done_at")
  cost             Decimal?  @db.Decimal(15, 2)
  remindedAt       DateTime? @map("reminded_at")

  asset Asset? @relation(fields: [assetId], references: [id])

  @@index([dueDate])
  @@map("maintenance_tasks")
}

model StockOpname {
  id         BigInt    @id @default(autoincrement())
  code       String    @unique @db.VarChar(24)
  unitId     Int?      @map("unit_id")
  locationId Int?      @map("location_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  closedAt   DateTime? @map("closed_at")
  status     String    @db.VarChar(16)
  createdBy  BigInt    @map("created_by")

  lines StockOpnameLine[]

  @@map("stock_opnames")
}

model StockOpnameLine {
  id                 BigInt          @id @default(autoincrement())
  opnameId           BigInt          @map("opname_id")
  assetId            BigInt          @map("asset_id")
  expectedLocationId Int?            @map("expected_location_id")
  found              Boolean?
  conditionFound     AssetCondition? @map("condition_found")
  locationFoundId    Int?            @map("location_found_id")
  note               String?         @db.VarChar(255)
  checkedAt          DateTime?       @map("checked_at")
  checkedBy          BigInt?         @map("checked_by")

  opname StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  asset  Asset       @relation(fields: [assetId], references: [id])

  @@unique([opnameId, assetId])
  @@map("stock_opname_lines")
}

model AssetDisposal {
  id                        BigInt   @id @default(autoincrement())
  code                      String   @unique @db.VarChar(24)
  reason                    String   @db.VarChar(32)
  method                    String   @db.VarChar(32)
  status                    String   @db.VarChar(24)
  note                      String?  @db.Text
  needsNazhir               Boolean  @default(false) @map("needs_nazhir")
  baFileId                  BigInt?  @map("ba_file_id")
  proceedsCashTransactionId BigInt?  @map("proceeds_cash_transaction_id")
  requestedBy               BigInt   @map("requested_by")
  createdAt                 DateTime @default(now()) @map("created_at")

  items AssetDisposalItem[]

  @@map("asset_disposals")
}

model AssetDisposalItem {
  id         BigInt   @id @default(autoincrement())
  disposalId BigInt   @map("disposal_id")
  assetId    BigInt   @map("asset_id")
  bookValue  Decimal  @map("book_value") @db.Decimal(15, 2)
  saleValue  Decimal? @map("sale_value") @db.Decimal(15, 2)

  disposal AssetDisposal @relation(fields: [disposalId], references: [id], onDelete: Cascade)
  asset    Asset         @relation(fields: [assetId], references: [id])

  @@map("asset_disposal_items")
}

/// Persetujuan berjenjang — dipakai Procurement, AssetLoan, AssetDisposal.
model ApprovalStep {
  id        BigInt    @id @default(autoincrement())
  entity    String    @db.VarChar(24)
  entityId  BigInt    @map("entity_id")
  order     Int
  roleKey   String    @map("role_key") @db.VarChar(32)
  unitId    Int?      @map("unit_id")
  decidedBy BigInt?   @map("decided_by")
  decision  String?   @db.VarChar(8)
  note      String?   @db.VarChar(255)
  decidedAt DateTime? @map("decided_at")

  @@index([entity, entityId])
  @@map("approval_steps")
}

/// Barang habis pakai (C2): ATK, kebersihan, dapur.
model ConsumableItem {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(160)
  unitOfMeasure String  @map("unit_of_measure") @db.VarChar(24)
  stock         Int     @default(0)
  minStock      Int     @default(0) @map("min_stock")
  unitId        Int?    @map("unit_id")
  storage       String? @db.VarChar(120)

  movements ConsumableMovement[]

  @@map("consumable_items")
}

model ConsumableMovement {
  id        BigInt   @id @default(autoincrement())
  itemId    Int      @map("item_id")
  direction String   @db.VarChar(8) // Masuk, Keluar
  quantity  Int
  purpose   String?  @db.VarChar(160)
  actorId   BigInt   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  item ConsumableItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("consumable_movements")
}

// ============================================================================
// Modul Presensi (plan 02-presensi-harian-dashboard.md)
// ============================================================================

/// Master sesi presensi santri (02 §2.1). `Attendance.session` tetap string, diisi `code` dari sini.
model AttendanceSession {
  id             Int     @id @default(autoincrement())
  code           String  @unique @db.VarChar(32)
  name           String  @db.VarChar(80)
  unitId         Int?    @map("unit_id")
  /// KELAS = per rombel (sekolah, madin), ASRAMA = per asrama (jamaah, ngaji malam, apel kamar).
  grouping       String  @default("KELAS") @db.VarChar(8)
  jamMulai       String  @map("jam_mulai") @db.VarChar(5)
  batasTerlambat String  @map("batas_terlambat") @db.VarChar(5)
  /// Bitmask hari aktif: Senin=1, Selasa=2, Rabu=4, Kamis=8, Jumat=16, Sabtu=32, Ahad=64.
  hariAktif      Int     @default(63) @map("hari_aktif")
  aktif          Boolean @default(true)
  order          Int     @default(0)

  @@map("attendance_sessions")
}

/// Jam kerja per unit per hari (1=Senin..7=Ahad), plus pengecualian per pegawai (staffId terisi).
model WorkSchedule {
  id             Int     @id @default(autoincrement())
  unitId         Int     @map("unit_id")
  staffId        BigInt? @map("staff_id")
  hari           Int
  jamMasuk       String  @map("jam_masuk") @db.VarChar(5)
  jamPulang      String  @map("jam_pulang") @db.VarChar(5)
  toleransiMenit Int     @default(15) @map("toleransi_menit")

  @@index([unitId, hari])
  @@map("work_schedules")
}

model Holiday {
  id     Int      @id @default(autoincrement())
  date   DateTime @db.Date
  name   String   @db.VarChar(120)
  unitId Int?     @map("unit_id")

  @@index([date])
  @@map("holidays")
}

/// Izin/sakit/cuti/dinas luar pegawai (02 §3.6), disetujui kepala unit / SDM.
model StaffLeave {
  id         BigInt   @id @default(autoincrement())
  staffId    BigInt   @map("staff_id")
  jenis      String   @db.VarChar(16)
  dari       DateTime @db.Date
  sampai     DateTime @db.Date
  alasan     String   @db.VarChar(255)
  lampiranId BigInt?  @map("lampiran_id")
  status     String   @default("Diajukan") @db.VarChar(16)
  approvedBy BigInt?  @map("approved_by")
  note       String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([staffId, dari])
  @@map("staff_leaves")
}
