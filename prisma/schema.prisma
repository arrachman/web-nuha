  verses    String   @db.VarChar(32)
  type      String   @db.VarChar(32)
  score     String   @db.VarChar(32)
  examiner  String   @db.VarChar(160)

  student Santri @relation(fields: [studentId], references: [id], onDelete: Cascade)

