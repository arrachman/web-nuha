  date      DateTime @map("date") @db.Date
  amount    Decimal  @map("amount") @db.Decimal(14, 2)
  method    String   @map("method") @db.VarChar(64)
  reference String?  @map("reference") @db.VarChar(64)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum CashDirection {
  Inbound
  Outbound
}

model CashTransaction {
  id          BigInt        @id @default(autoincrement())
  code        String        @unique @map("code") @db.VarChar(24)
  date        DateTime      @map("date") @db.Date
  description String        @map("description") @db.VarChar(255)
  category    String        @map("category") @db.VarChar(64)
  method      String        @map("method") @db.VarChar(64)
  direction   CashDirection @map("direction")
  amount      Decimal       @map("amount") @db.Decimal(14, 2)

  @@index([date])
  @@map("cash_transactions")
}

