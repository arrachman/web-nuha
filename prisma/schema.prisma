// ─────────────────────────────────────────────────────────────
// Fase 7 — penjadwal notifikasi WA (cron eksternal, bukan setInterval Next.js)
// ─────────────────────────────────────────────────────────────

/// Satu baris = satu "job" penjadwal yang dijalankan proses `nuha-cron`.
/// `kodeTemplate` di sini adalah kode JOB, bukan selalu identik dengan
/// `TemplateWa.kode` — WA-GUR-04 punya dua pemicu waktu (H-1 pukul 19.00 dan
/// H-0 45 menit sebelum shift, keduanya dinamis per baris `JadwalPiket`)
/// sehingga dipecah jadi dua job (`WA-GUR-04-H1`, `WA-GUR-04-H0`) yang
/// keduanya mengirim template `WA-GUR-04` yang sama. Lihat `lib/penjadwal/`.
model NotificationSchedule {
  id           Int       @id @default(autoincrement())
  templateCode String    @unique @map("template_code") @db.VarChar(32)
  cron         String    @db.VarChar(32)
  isActive     Boolean   @default(true) @map("is_active")
  lastRunAt    DateTime? @map("last_run_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("notification_schedules")
}

/// Idempotent queue. `recipientId` identifies the recipient within a job.
model NotificationQueue {
  id            BigInt   @id @default(autoincrement())
  templateCode  String   @map("template_code") @db.VarChar(32)
  recipientId   String   @map("recipient_id") @db.VarChar(64)
  scheduledDate DateTime @map("scheduled_date") @db.Date
  status        String   @default("Terkirim") @db.VarChar(24)
  waLogId       BigInt?  @map("wa_log_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([templateCode, recipientId, scheduledDate])
  @@index([scheduledDate])
  @@map("notification_queue")
}

