  name     String  @unique @db.VarChar(160)
  unit     String  @db.VarChar(32)
  category String? @db.VarChar(64)
  stock    Int     @default(0)
  minStock Int     @default(0) @map("min_stock")
  expiry   String? @db.VarChar(32)

  @@map("medicines")
}

// ─────────────────────────────────────────────────────────────
// Keuangan
